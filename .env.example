# HomeView settings. Copy to ".env" and edit. Never commit your real .env.

# Public address of the dashboard (used in links; https enables Secure cookies).
HOMEVIEW_BASE_URL=http://192.168.1.10:8080
# Host port published by Docker (the container always listens on 8080).
HOMEVIEW_PORT=8080
# Interface language: pt-BR or en (users can switch in the page footer).
HOMEVIEW_LANG=pt-BR
TZ=America/Sao_Paulo

# Extra host names that mean "I am on my home network" (comma separated).
# Private IPs, *.lan and *.local are detected automatically.
HOMEVIEW_INTERNAL_HOSTS=

# --- SMTP (required: login codes are sent by e-mail) ---
HOMEVIEW_SMTP_HOST=smtp.example.com
HOMEVIEW_SMTP_PORT=587
# starttls (587, default) | tls (465) | none (trusted local relay only)
HOMEVIEW_SMTP_SECURITY=starttls
HOMEVIEW_SMTP_USER=
HOMEVIEW_SMTP_PASS=
# Sender, e.g.  HomeView <homeview@example.com>
HOMEVIEW_SMTP_FROM=
